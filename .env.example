AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-oss-120b
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CLIENT_MODE=v1
MOCK_LLM=0
# Hosted deployments require durable storage and all four generated private JWKs.
# Local/development identity. Production hosting explicitly sets production.
APP_ENV=development
STORE_BACKEND=sqlite
SQLITE_PATH=.intent-judge.sqlite3
AZURE_TABLE_CONNECTION_STRING=
AZURE_TABLE_NAME=IntentJudge
# Optional hosted override for a shared cross-environment AI budget ledger.
# Preview/dev can use AZURE_TABLE_NAME=IntentJudgeDev while pointing this at
# the existing production table; leave unset in production for compatibility.
AI_BUDGET_TABLE_NAME=
# Optional only when the shared budget ledger uses another storage account.
AI_BUDGET_TABLE_CONNECTION_STRING=
DEMO_SIGNING_KEYS=
AI_CALL_LIMIT=500
AI_DAILY_LIMIT=80
AI_SESSION_LIMIT=16
AI_RESERVATION_USD=0.02
# Optional, explicit validation-only extension; defaults to disabled and is
# bounded by the application to $10.00. Never set this casually in production.
AI_EMERGENCY_BUDGET_CENTS=0
AI_EVAL_DAILY_LIMIT=100
AI_MONITOR_CALL_LIMIT=40
AI_PIPELINE_VERSION=adaptive
CRON_SECRET=
